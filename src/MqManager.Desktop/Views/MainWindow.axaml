<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MqManager.Desktop.ViewModels"
        x:Class="MqManager.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="500">

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppHeaderBgBrush}"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding DisplayTitle}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding ToggleThemeCommand}"
                        Content="{Binding ThemeIcon}"
                        Background="Transparent"
                        Foreground="White"
                        FontSize="16"
                        Padding="8,4"
                        MinWidth="36"
                        ToolTip.Tip="{Binding ThemeTooltip}" />
                <Button Grid.Column="2"
                        Command="{Binding ToggleLanguageCommand}"
                        Content="{Binding CurrentLanguage}"
                        Background="Transparent"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Padding="10,4"
                        MinWidth="40" />
                <Button Grid.Column="3"
                        Command="{Binding DisconnectCommand}"
                        Content="{Binding DisconnectText}"
                        Background="Transparent"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Padding="12,4"
                        IsVisible="{Binding IsConnected}" />
            </Grid>
        </Border>

        <!-- Tab bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppTabBarBgBrush}"
                Padding="0,0">
            <TabControl SelectedIndex="{Binding ActiveTabIndex}"
                        Background="Transparent"
                        BorderThickness="0">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="#BBDEFB" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="24,10" />
                    </Style>
                    <Style Selector="TabItem:selected">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="{DynamicResource AppHeaderBgBrush}" />
                    </Style>
                </TabControl.Styles>
                <TabItem Header="{Binding QueuesTab}" />
                <TabItem Header="{Binding ChannelsTab}" />
                <TabItem Header="{Binding ConnectionsTab}" />
                <TabItem Header="{Binding AuditLogTab}" />
            </TabControl>
        </Border>

        <!-- Main content -->
        <Grid ColumnDefinitions="350,*">
            <!-- Left Panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource AppSidebarBgBrush}"
                    BorderBrush="{DynamicResource AppSidebarBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ContentControl Content="{Binding SidebarContent}" />
            </Border>

            <!-- Right Panel -->
            <Border Grid.Column="1"
                    Background="{DynamicResource AppContentBgBrush}">
                <ContentControl Content="{Binding ContentPanel}" />
            </Border>

            <!-- Login Overlay -->
            <ContentControl Grid.ColumnSpan="2"
                            Content="{Binding LoginView}"
                            IsVisible="{Binding !IsConnected}" />
        </Grid>
    </DockPanel>
</Window>
