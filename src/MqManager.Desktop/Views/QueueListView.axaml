<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MqManager.Desktop.ViewModels"
             xmlns:models="using:MqManager.Desktop.Models"
             xmlns:coremodels="using:MqManager.Core.Models"
             x:Class="MqManager.Desktop.Views.QueueListView"
             x:DataType="vm:QueueListViewModel">

    <DockPanel>
        <!-- Header with filter and refresh -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="12,12,12,8">
            <TextBox Text="{Binding Filter}"
                     Watermark="{Binding FilterPlaceholder}"
                     MinHeight="36"
                     FontSize="13" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding RefreshText}"
                        Command="{Binding RefreshCommand}"
                        Height="32"
                        MinWidth="80"
                        FontSize="13" />
                <TextBlock Text="{Binding CountText}"
                           FontSize="12"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Height="3"
                     Margin="0" />

        <!-- Error message -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding ErrorMessage}"
                   Foreground="#D32F2F"
                   TextWrapping="Wrap"
                   Margin="12,0,12,4"
                   FontSize="12"
                   IsVisible="{Binding HasError}" />

        <!-- Queue list (last child — fills remaining space) -->
        <ListBox ItemsSource="{Binding Queues}"
                 SelectedItem="{Binding SelectedQueue}"
                 Margin="0,0"
                 Background="Transparent"
                 MinHeight="100">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="coremodels:QueueInfo">
                    <Border Padding="12,8"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Background="Transparent">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   Foreground="{DynamicResource AppPrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
