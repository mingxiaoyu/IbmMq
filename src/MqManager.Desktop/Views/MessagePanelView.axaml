<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MqManager.Desktop.ViewModels"
             xmlns:models="using:MqManager.Desktop.Models"
             xmlns:coremodels="using:MqManager.Core.Models"
             x:Class="MqManager.Desktop.Views.MessagePanelView"
             x:DataType="vm:MessagePanelViewModel"
             x:Name="Root">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSectionHeaderBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding QueueName}"
                           FontSize="18"
                           FontWeight="Bold" />
                <Border Background="{DynamicResource AppDepthBadgeBgBrush}"
                        CornerRadius="12"
                        Padding="12,4"
                        VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource AppDepthBadgeFgBrush}"
                               FontSize="13"
                               Text="{Binding DepthDisplay}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="16,12">
            <Button Content="{Binding SendText}"
                    Command="{Binding SendMessageCommand}"
                    Background="#1976D2"
                    Foreground="White"
                    Height="32" />
            <Button Content="{Binding BrowseText}"
                    Command="{Binding BrowseMessagesCommand}"
                    Height="32" />
            <Button Content="{Binding GetMessageText}"
                    Command="{Binding GetMessagesCommand}"
                    Height="32" />
            <Button Content="{Binding PurgeText}"
                    Command="{Binding PurgeQueueCommand}"
                    Foreground="#D32F2F"
                    Height="32" />
            <Button Content="{Binding ConsumeAllText}"
                    Command="{Binding ConsumeAllCommand}"
                    Height="32" />
            <Button Content="{Binding ExportAllText}"
                    Command="{Binding ExportAllMessagesCommand}"
                    Height="32" />
        </StackPanel>

        <!-- Body: resizable split between input and messages -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="220" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" MinHeight="80" />
            </Grid.RowDefinitions>

            <!-- Input area (Row 0) -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Mode selection -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
                        <RadioButton Content="{Binding SingleMessageText}"
                                     IsChecked="{Binding IsTextMode}"
                                     GroupName="SendMode"
                                     Command="{Binding SetTextModeCommand}" />
                        <RadioButton Content="{Binding FromFileText}"
                                     IsChecked="{Binding IsFileMode}"
                                     GroupName="SendMode"
                                     Command="{Binding SetFileModeCommand}" />
                        <RadioButton Content="{Binding FromFolderText}"
                                     IsChecked="{Binding IsFolderMode}"
                                     GroupName="SendMode"
                                     Command="{Binding SetFolderModeCommand}" />
                    </StackPanel>

                    <!-- Message input (text mode) fills the middle row -->
                    <TextBox Grid.Row="1"
                             Text="{Binding MessageText}"
                             Watermark="{Binding EnterMessageText}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsVisible="{Binding IsTextMode}" />

                    <!-- File path input -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Top"
                                IsVisible="{Binding IsFileMode}">
                        <TextBox Text="{Binding FilePath}"
                                 Watermark="{Binding SelectFileText}"
                                 MinHeight="32"
                                 MinWidth="300" />
                        <Button Content="{Binding BrowseButton}"
                                Command="{Binding BrowseFileCommand}"
                                MinWidth="36"
                                Height="32" />
                    </StackPanel>

                    <!-- Folder path input -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Top"
                                IsVisible="{Binding IsFolderMode}">
                        <TextBox Text="{Binding FolderPath}"
                                 Watermark="{Binding SelectFolderText}"
                                 MinHeight="32"
                                 MinWidth="300" />
                        <Button Content="{Binding BrowseButton}"
                                Command="{Binding BrowseFolderCommand}"
                                MinWidth="36"
                                Height="32" />
                    </StackPanel>

                    <!-- Count input -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <TextBlock Text="{Binding CountLabel}"
                                   VerticalAlignment="Center" />
                        <AutoCompleteBox Text="{Binding MessageCountText}"
                                         ItemsSource="{Binding MessageCountSuggestions}"
                                         MinimumPrefixLength="0"
                                         FilterMode="StartsWith"
                                         Width="120"
                                         VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- GridSplitter (Row 1) -->
            <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource AppBorderBrush}"
                          ResizeDirection="Rows" />

            <!-- Messages list (Row 2) -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Messages}"
                     Margin="16,8">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected Border.msg-card">
                        <Setter Property="Background" Value="{DynamicResource AppDepthBadgeBgBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppDepthBadgeFgBrush}"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover:not(:selected) Border.msg-card">
                        <Setter Property="Background" Value="{DynamicResource AppSectionHeaderBgBrush}"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="coremodels:MessageInfo">
                        <Border Classes="msg-card"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,4">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding #Root.DataContext.CopyBodyLabel}"
                                              Command="{Binding #Root.DataContext.CopyMessageBodyCommand}"
                                              CommandParameter="{Binding Body}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding #Root.DataContext.IdLabel}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                               Width="70" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MessageId}"
                                               FontFamily="Consolas"
                                               FontSize="12" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PutDateTime}"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="12" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding #Root.DataContext.CorrelationLabel}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}"
                                               Width="70" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CorrelationId}"
                                               FontFamily="Consolas"
                                               FontSize="12" />
                                </Grid>
                                <Border Background="{DynamicResource AppSectionHeaderBgBrush}"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Body}"
                                               TextWrapping="Wrap"
                                               MaxLines="5"
                                               FontFamily="Consolas"
                                               FontSize="12" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Loading overlay (spans all rows) -->
            <Border Grid.Row="0" Grid.RowSpan="3"
                    IsVisible="{Binding IsLoading}"
                    Background="#60000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border Background="{DynamicResource AppContentBgBrush}"
                        CornerRadius="12"
                        Padding="32,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BoxShadow="0 4 24 0 #40000000">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="200"
                                     Height="4" />
                        <TextBlock Text="{Binding LoadingText}"
                                   HorizontalAlignment="Center"
                                   FontSize="14" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
