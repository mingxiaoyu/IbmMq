<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MqManager.Desktop.ViewModels"
             xmlns:models="using:MqManager.Desktop.Models"
             xmlns:conv="using:MqManager.Desktop.Converters"
             x:Class="MqManager.Desktop.Views.ConnectionListView"
             x:DataType="vm:ConnectionListViewModel"
             x:Name="Root">

    <DockPanel>
        <!-- Header with filter and buttons -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="12,12,12,8">
            <TextBox Text="{Binding Filter}"
                     Watermark="{Binding FilterPlaceholder}"
                     MinHeight="36"
                     FontSize="13" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding RefreshText}"
                        Command="{Binding LoadConnectionsCommand}"
                        Height="32"
                        MinWidth="80"
                        FontSize="13" />
                <Button Content="{Binding ExportCsvText}"
                        Command="{Binding ExportCsvCommand}"
                        Height="32"
                        MinWidth="90"
                        FontSize="13" />
            </StackPanel>
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Height="3"
                     Margin="0" />

        <!-- Error message -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding ErrorMessage}"
                   Foreground="#D32F2F"
                   TextWrapping="Wrap"
                   Margin="12,0,12,4"
                   FontSize="12"
                   IsVisible="{Binding HasError}" />

        <!-- Connection list (last child — fills remaining space) -->
        <ListBox ItemsSource="{Binding Connections}"
                 SelectedItem="{Binding SelectedConnection}"
                 Margin="0,0"
                 MinHeight="100"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ConnectionInfo">
                    <Border Padding="12,8"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Background="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChannelName}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} | {1} | {2}">
                                            <Binding Path="AppName" />
                                            <Binding Path="UserId" />
                                            <Binding Path="ConnectionName" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Background="{Binding Status, Converter={x:Static conv:ValueConverters.StatusToBrush}}">
                                <TextBlock Text="{Binding Status}"
                                           FontSize="12"
                                           Foreground="White"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
